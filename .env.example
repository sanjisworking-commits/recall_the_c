APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8010
PORT=8010

# Enable the multi-user auth gate and per-user progress.
MULTIUSER_ENABLED=true

# V1 production defaults: keep Memory Log / Relevant Laws off.
# MEMORY_LOG_ENABLED=true is not supported with PostgreSQL yet.
MEMORY_LOG_ENABLED=false
RELEVANT_LAWS_ENABLED=false

# 3-Free-Article entitlement boundary (claim prompts, Type/Recite locks,
# cap gate, access-status surfaces). Keep false until steps 1-4 are verified;
# requires `alembic upgrade head` (user_free_articles) on Postgres.
ARTICLE_ENTITLEMENTS_ENABLED=false

# /pricing page. Keep false publicly until a purchase flow exists.
PRICING_ENABLED=false

DATABASE_URL=postgresql://user:password@localhost:5432/recall_the_c_multiuser

SUPABASE_URL=
SUPABASE_ANON_KEY=

SESSION_SECRET=

AUTH_GOOGLE_ENABLED=true
# Phone OTP paused pending SMS registration; login still shows the option as unavailable.
AUTH_PHONE_ENABLED=false

COOKIE_SECURE=false

# Optional CAPTCHA integration point for staging/production OTP sends.
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=

# Optional Resend admin email for issue reports (all three required to enable).
RESEND_API_KEY=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# Optional Cloudflare Turnstile for POST /api/report-issue (server-side).
# When enabled, both site key and secret key are required.
REPORT_TURNSTILE_ENABLED=false
REPORT_TURNSTILE_SITE_KEY=
REPORT_TURNSTILE_SECRET_KEY=

# Razorpay Standard Checkout. Both keys present = the purchase flow takes
# real payments; either missing = /subscribe/pay keeps its placeholder.
# The secret is server-side only; never expose it to client code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Calendar integration (dedicated OAuth client — NEVER reuse the
# Supabase sign-in client; the Calendar grant must be independently
# revocable). GCAL_TOKEN_KEY is a Fernet key sealing refresh tokens at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# All three present = the feature exists; any missing = section hidden.
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_TOKEN_KEY=

# Deepgram Nova-3 for spoken Letters/Recite. Server-side only — never
# expose this to the browser. Blank = speech UI shows typed fallback.
DEEPGRAM_API_KEY=

# Public legal pages (/terms, /privacy, /grievance). Leave empty until the
# real operator identity exists. Pages display "Not yet configured".
# Do not submit Google verification while any of these are blank.
LEGAL_ENTITY_NAME=
LEGAL_BUSINESS_ADDRESS=
LEGAL_JURISDICTION=
LEGAL_SUPPORT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_GRIEVANCE_EMAIL=
LEGAL_GRIEVANCE_OFFICER=
LEGAL_PRIVACY_CONTACT=
