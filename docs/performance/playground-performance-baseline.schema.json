{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recall.local/schemas/playground-performance-baseline.json",
  "title": "Playground WS6 performance baseline (schema sample)",
  "description": "Machine-specific timings are not committed. This file documents the JSON shape written by scripts/benchmark_playground.py. Stage metrics union names across samples: a 0.0 contribution means that stage did not execute on that sample, not a measured 0 ms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "app_env",
    "database_backend",
    "warmup_discarded",
    "iterations",
    "path_group",
    "method",
    "status_counts",
    "metrics",
    "stages_present"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "scenario": {
      "type": "string",
      "enum": [
        "plus-10",
        "pro-30",
        "due-heavy",
        "learned-heavy",
        "source-review",
        "law-workspace"
      ]
    },
    "app_env": {
      "type": "string",
      "description": "Effective validated environment after the fail-closed guard. Ordinary runs are test. development requires BENCHMARK_ALLOW_NONTEST=1. staging/production require that flag and --i-accept-nontest-db. Process staging/production cannot be masked by --app-env test."
    },
    "database_backend": { "type": "string", "enum": ["sqlite", "postgresql"] },
    "warmup_discarded": { "type": "integer", "minimum": 0 },
    "iterations": { "type": "integer", "minimum": 1 },
    "path_group": { "type": "string" },
    "method": { "type": "string", "enum": ["GET"] },
    "status_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "metrics": {
      "type": "object",
      "description": "Distributions for total_ms, playground_repo_round_trips, playground_db_reads, and each unioned timing stage. If a stage is absent from a sample, that sample contributes 0.0 as 'stage not executed', not a measured 0 ms.",
      "required": ["total_ms", "playground_repo_round_trips", "playground_db_reads"],
      "additionalProperties": { "$ref": "#/$defs/summary" }
    },
    "stages_present": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes_observed": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min", "mean", "p50", "p95", "p99", "max"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "min": { "type": "number" },
        "mean": { "type": "number" },
        "p50": { "type": "number" },
        "p95": { "type": "number" },
        "p99": { "type": "number" },
        "max": { "type": "number" }
      }
    }
  }
}
